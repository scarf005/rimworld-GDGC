<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <MemeDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>GDGC_GoblinExceptionalism</defName>
    <label>goblin exceptionalism</label>
    <description>Goblins are sinful by their very existence, and 'human' rights are merely a luxury for these cannibals. Turning them into meat should make us feel absolutely nothing.</description>
    <iconPath>UI/Icons/GDGC_GoblinExceptionalism</iconPath>
    <impact>2</impact>
    <randomizationSelectionWeightFactor>0</randomizationSelectionWeightFactor>
    <generalRules>
      <rulesStrings>
        <li>memeAdjective->anti-goblin</li>
        <li>memeAdjective->goblin-exceptionalist</li>
        <li>memeCreed->the goblin exception</li>
        <li>memeCreed->the green exclusion</li>
        <li>memeConcept->goblin exclusion</li>
        <li>memeConcept->protected personhood</li>
        <li>memeLeaderNoun->goblin slayer</li>
      </rulesStrings>
    </generalRules>
  </MemeDef>
</Defs>
